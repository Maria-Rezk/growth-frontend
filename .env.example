# Backend has the /api prefix, so include it here.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional dev proxy.
#
# Use it when the API runs on another host whose CORS allow-list does not name
# your dev origin. Because the refresh token is an httpOnly cookie, every
# request is credentialed, and a credentialed cross-origin request is refused
# outright unless the API names http://localhost:5173 explicitly.
#
# To develop against the deployed API, set BOTH of these instead of the line
# above — the app then calls its own origin and Vite forwards server-side,
# where CORS does not apply:
#
#   VITE_API_BASE_URL=/api
#   VITE_DEV_PROXY_TARGET=https://api.solu1ions.tech
#
# Dev only. Production builds always call VITE_API_BASE_URL directly, so the
# deployed origin must be in the API's allow-list with
# Access-Control-Allow-Credentials: true.
# VITE_DEV_PROXY_TARGET=

# Set to true only when you want to preview the dashboard without login/backend data.
VITE_DEMO_MODE=false

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=25000

VITE_APP_NAME=Solu1ions Growth OS
