# Dev-only overrides. Vite loads this for `npm run dev` and IGNORES it for
# `npm run build`, so production always uses the absolute URL from .env.
#
# The API's CORS allow-list names https://solu1ions.tech only, and every
# request is credentialed (the refresh token is an httpOnly cookie), so a
# credentialed call from http://localhost:5173 is refused outright. Calling our
# own origin and letting Vite forward server-side avoids CORS entirely.
#
# Delete this file once http://localhost:5173 is in the API's allow-list.
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=https://api.solu1ions.tech
